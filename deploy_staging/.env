APP_NAME="IPL Griya Pesona Madani"
APP_ENV=production
APP_KEY=base64:GENERATE_THIS_KEY
APP_DEBUG=false
APP_URL=https://ipl-griya-pesona-madani.my.id

LOG_CHANNEL=daily
LOG_LEVEL=error

# Database — IDcloudHost MySQL
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=dszgofcr_ipl_db
DB_USERNAME=dszgofcr_ipl_user
DB_PASSWORD=GANTI_DENGAN_PASSWORD_DB_ANDA

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Midtrans (pakai keys yang sama dengan Railway)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true

# WhatsApp Admin
ADMIN_PHONE=6282115525327

# Frontend URL (Vercel backoffice)
FRONTEND_URL=https://your-backoffice.vercel.app

# IPL Amount Default
IPL_MONTHLY_AMOUNT=150000
IPL_KEDUKAAN_AMOUNT=85000

# Cloudinary (untuk storage gambar — daftar di cloudinary.com gratis)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
